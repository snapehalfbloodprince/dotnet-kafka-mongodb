{
  "Application": {
    "Name": "KafkaRouter.Worker",
    "Environment": "Local"
  },
  "Worker": {
    "ErrorDelayInSeconds": 5,
    "ConsecutiveFailuresWarningThreshold": 5,
    "TechnicalRetryMaxAttempts": 3,
    "TechnicalRetryInitialDelayInSeconds": 1,
    "TechnicalRetryMaxDelayInSeconds": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "InputTopic": "events.inbound",
    "DeadLetterTopic": "events.dead-letter",
    "ConsumerGroupId": "kafka-router-worker-local",
    "AutoOffsetReset": "Earliest"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://root:rootpassword@localhost:27017",
    "DatabaseName": "kafka_router",
    "RoutingRulesCollectionName": "routing_rules"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}